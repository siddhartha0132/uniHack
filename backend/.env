# Veritas Backend — Environment Variables
# Copy this file to .env and fill in your values.
# This file is read automatically by python-dotenv at startup.

# ── Phase 2: LLM Extraction Fallback ──────────────────────────────────────
# NVIDIA NIM API key — get yours at https://build.nvidia.com/
NVIDIA_API_KEY=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
NVIDIA_MODEL=minimaxai/minimax-m3

# Model to use for LLM extraction fallback
LLM_MODEL=meta/llama-4-scout-17b-16e-instruct

# Set to "false" to disable LLM fallback entirely (regex-only mode)
LLM_FALLBACK_ENABLED=true

# ── Phase 3: Database ──────────────────────────────────────────────────────
# SQLite (default, zero setup):
DATABASE_URL=sqlite:///./veritas.db

# Postgres example (uncomment and fill in for production):
# DATABASE_URL=postgresql://veritas_user:password@localhost:5432/veritas

# ── Authentication ──────────────────────────────────────────────────────────
JWT_SECRET=SZIoMcjJGwOQTORkjBG0Pgni6tFEEpsry6475QrGtCo=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080

# ── CORS ────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# ── Frontend ────────────────────────────────────────────────────────────────
# Set this in frontend/.env.local (not here)
# VITE_API_BASE=http://127.0.0.1:8000