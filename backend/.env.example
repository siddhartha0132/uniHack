# Veritas Backend Configuration
# Copy to .env and modify as needed

# Database
# SQLite (development default)
DATABASE_URL=sqlite:///./veritas.db

# PostgreSQL (production)
# DATABASE_URL=postgresql://veritas:password@localhost:5432/veritas

# Authentication
# Generate with: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — restrict to your frontend domain(s) in production!
# Comma-separated list
CORS_ORIGINS=http://localhost:5500,http://127.0.0.1:5500

# Phase 2: LLM Extraction Fallback (optional)
# Get from https://build.nvidia.com/ or platform.openai.com
NVIDIA_API_KEY=
OPENAI_API_KEY=

# Phase 7: Discovery Agent (optional)
# Search API key for auto-datasheet discovery
SEARCH_API_KEY=

# Logging
LOG_LEVEL=INFO